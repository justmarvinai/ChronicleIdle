{
  "name": "chronicleidle",
  "version": "0.9.6",
  "private": true,
  "description": "ChronicleIdle \u2014 a turn-based idle gacha champion-collection RPG for the desktop browser.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx tools/assets/build.ts --quiet && vite",
    "build": "tsx tools/assets/build.ts && pnpm typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tools/tsconfig.json --noEmit",
    "content:validate": "tsx tools/content/validate.ts",
    "assets:build": "tsx tools/assets/build.ts",
    "assets:check": "tsx tools/assets/build.ts --check",
    "perf:battle": "tsx tools/perf/battle-bench.ts",
    "perf:budget": "tsx tools/perf/budget.ts",
    "perf:lighthouse": "tsx tools/perf/lighthouse.ts",
    "sim:balance": "tsx tools/sim/balance.ts",
    "sim:economy": "tsx tools/sim/economy.ts",
    "fixtures:version": "tsx tools/fixtures/version-save.ts"
  },
  "dependencies": {
    "@fontsource/alegreya-sans-sc": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "idb": "^8.0.3",
    "immer": "^11.1.18",
    "motion": "^13.2.0",
    "pixi.js": "^8.20.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "wasm-media-encoders": "^0.7.0",
    "workbox-window": "^7.4.1"
  }
}
